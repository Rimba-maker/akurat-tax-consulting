---
import "../styles/global.css";
import Stamp from "../components/Stamp.astro";

const pain = [
  { title: "Bingung Lapor SPT Bulanan/Tahunan", problem: "Salah lapor = denda Rp100k - jutaan per bulan.", fix: "Kami handle semua filing tepat waktu.", r: "-1.2deg" },
  { title: "Pajak Selalu Lebih Besar Dari Kompetitor", problem: "Mungkin Anda belum optimalisasi.", fix: "Kami analisa struktur pajak Anda.", r: "1.6deg", carbon: true },
  { title: "Dapat Surat Tagihan / SP2DK dari KPP", problem: "Butuh response cepat & tepat.", fix: "Tim kami siap handle dispute resolution.", r: "1deg", letter: true },
  { title: "Mau Restitusi, Tapi Takut Diperiksa", problem: "Takut restitusi berujung pemeriksaan?", fix: "Kami bantu strategi restitusi yang aman dengan persiapan dokumen lengkap.", r: "-1.4deg" },
  { title: "Bisnis Multi-Channel, Reporting Kompleks", problem: "Online + offline = kompleksitas.", fix: "Kami bikin reporting jadi sederhana.", r: "1.2deg" },
  { title: "Setup PT Baru, Bingung Struktur Pajak", problem: "PPh Badan vs PPh Final?", fix: "Kami bantu pilih struktur yang tepat.", r: "-0.8deg", carbon: true },
];

const services = [
  { name: "Tax Compliance", img: "svc-compliance", alt: "Formulir pajak, ponsel dengan kalkulator, dan secangkir kopi di meja", r: "2deg", items: ["Pelaporan SPT bulanan & tahunan", "PPh 21, 23, 25, 26, 4(2), PPN", "Filing tepat waktu (kami tracking deadline)"] },
  { name: "Tax Planning & Optimization", img: "svc-planning", alt: "Tim berdiskusi menyusun strategi di depan whiteboard", r: "-2deg", items: ["Analisa struktur bisnis untuk efisiensi pajak", "Optimalisasi PPh Badan, PPh Final UMKM, PPN", "Pre-transaction tax advisory"] },
  { name: "Tax Audit Assistance", img: "svc-audit", alt: "Dua orang memeriksa dan menandatangani dokumen di meja", r: "1.5deg", items: ["Pendampingan saat pemeriksaan KPP", "Penyusunan dokumen & klarifikasi", "Negosiasi pengurangan koreksi fiskal"] },
  { name: "Restitusi & Pengembalian Pajak", img: "svc-restitusi", alt: "Dokumen laporan pendapatan dan checklist pajak dengan ponsel kalkulator", r: "-1.5deg", items: ["Analisa kelayakan restitusi", "Persiapan dokumen", "Pendampingan proses pemeriksaan"] },
  { name: "Tax Setup Bisnis Baru", img: "svc-setup", alt: "Dua rekan kerja mengerjakan laptop di kantor kecil", r: "2.5deg", items: ["Konsultasi pemilihan badan usaha", "Pendaftaran NPWP, PKP", "Setup chart of account & tax structure"] },
  { name: "Tax for Expatriate & Cross-Border", img: "svc-expat", alt: "Jabat tangan di atas dokumen kesepakatan bisnis", r: "-2deg", items: ["Tax filing untuk WNA bekerja di Indonesia", "Tax treaty analysis", "Transfer pricing documentation"] },
];

const plans = [
  { key: "Starter", price: "3,5 jt", unit: "/ bulan", who: "Untuk UMKM omzet < Rp 4,8 M/tahun", cta: "Pilih Paket", btn: "btn--ink", items: ["Pelaporan SPT bulanan (PPh 21, 25, PPN)", "Pelaporan SPT tahunan", "Konsultasi WhatsApp jam kerja", "Monthly tax compliance report", "Email & call support"] },
  { key: "Business", price: "8 jt", unit: "/ bulan", who: "Untuk perusahaan menengah omzet Rp\u00a05\u00a0s.d.\u00a050\u00a0M/tahun", cta: "Pilih Paket", btn: "", pop: true, items: ["Semua Starter +", "Tax planning quarterly review", "Audit support", "Dedicated tax consultant", "Priority response < 4 jam", "2x site visit / tahun"] },
  { key: "Enterprise", price: "15 jt+", unit: "/ bulan", who: "Untuk perusahaan besar / multi-entity", cta: "Hubungi Kami", btn: "btn--ink", carbon: true, items: ["Semua Business +", "Transfer pricing analysis", "Tax due diligence", "Custom reporting dashboard", "24/7 emergency support", "Quarterly executive review"] },
];

const once = [
  ["SPT Tahunan one-time", "mulai Rp 1,5 jt"],
  ["Restitusi case (success fee)", "mulai Rp 5 jt"],
  ["Audit defense", "mulai Rp 7,5 jt"],
  ["Tax setup PT baru", "mulai Rp 4 jt"],
];

const industries = [
  { t: "t1", name: "F&B & Restoran", tax: "PB1, PPh Final UMKM, multi-outlet", img: "ind-fnb", alt: "Pemilik restoran memegang tablet di area makan" },
  { t: "t2", name: "E-commerce & Retail", tax: "Marketplace tax, omnichannel", img: "ind-ecom", alt: "Pemilik toko melayani pembayaran ponsel di kasir" },
  { t: "t3", name: "Konstruksi & Properti", tax: "PPh Final konstruksi, PPN, BPHTB", img: "ind-konstruksi", alt: "Arsitek berhelm meninjau gambar proyek" },
  { t: "t4", name: "Tech & SaaS Startup", tax: "Stock option, R&D incentive, capital raising", img: "ind-tech", alt: "Tim startup bekerja dengan laptop, dilihat dari atas" },
  { t: "t5", name: "Healthcare & Clinic", tax: "PPh Profesi, BPJS compliance", img: "ind-health", alt: "Staf klinik di meja resepsionis" },
  { t: "t6", name: "Creative & Agency", tax: "PPh 21 freelancer, project-based tax", img: "ind-creative", alt: "Papan tulis penuh sticky notes hasil brainstorming" },
  { t: "t7", name: "Manufaktur", tax: "PPN PPnBM, import-export, fasilitas BKPM", img: "ind-manufaktur", alt: "Pekerja pabrik tekstil melipat produk di lini produksi" },
  { t: "t8", name: "Profesional Services", tax: "Konsultan, akuntan, pengacara", img: "ind-profesional", alt: "Profesional memeriksa dokumen di meja kerja dekat jendela" },
];

const why = [
  ["Sertifikasi Resmi USKP A & B", "Lisensi konsultan pajak Kementerian Keuangan."],
  ["Response Time < 4 Jam", "Pertanyaan urgent dibalas dalam 4 jam kerja."],
  ["Transparent Reporting", "Dashboard online, lihat status compliance real-time."],
  ["Dedicated Consultant", "Satu PIC untuk bisnis Anda, no rotation."],
  ["Confidentiality NDA", "Data klien dilindungi NDA tertulis."],
  ["No Hidden Fees", "Harga di awal sesuai paket, no surprise charge."],
];

const team = [
  { name: "Drs. Bambang Santoso, Ak., BKP", role: "Managing Partner", chips: ["USKP-B", "Ex-Big 4", "18+ tahun"], img: "team-bambang", r: "-1.5deg", pos: "50% 25%" },
  { name: "Maya Hartono, S.E., M.Ak., BKP", role: "Tax Compliance Lead", chips: ["USKP-A", "Ex-KAP Big 4"], img: "team-maya", r: "1.2deg", pos: "28% 20%" },
  { name: "Reza Pradana, S.E., Ak., M.M.", role: "Tax Planning Specialist", chips: ["MBA", "12+ tahun"], img: "team-reza", r: "-1deg", pos: "50% 30%" },
  { name: "Indra Wijaya, S.H., BKP", role: "Tax Dispute Resolution", chips: ["Ex-DJP", "15+ tahun"], img: "team-indra", r: "1.6deg", pos: "50% 22%" },
];

const steps = [
  { t: "Konsultasi Awal", d: "Diskusi 30 menit, analisa kebutuhan bisnis.", pen: "gratis!", r: "-9deg" },
  { t: "Tax Assessment", d: "Review SPT 2 tahun terakhir, identifikasi risiko.", r: "6deg" },
  { t: "Proposal & Kontrak", d: "Penawaran paket, scope, timeline, kontrak NDA.", r: "-5deg" },
  { t: "Onboarding & Service", d: "Data collection, akses sistem, kickoff meeting.", r: "8deg" },
];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Akurat Tax Consulting",
  description: "Konsultan pajak bersertifikat USKP A & B: tax compliance, planning, audit, restitusi.",
  areaServed: ["Jakarta Selatan", "Surabaya", "Bandung"],
  slogan: "Pajak Tepat, Bisnis Lancar.",
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akurat Tax Consulting — Konsultan Pajak Bersertifikat USKP Jakarta</title>
    <meta name="description" content="Konsultan pajak bersertifikat USKP A & B. Tax compliance, planning, audit, restitusi untuk UMKM, startup, & perusahaan menengah. 200+ klien aktif." />
    <meta name="keywords" content="konsultan pajak jakarta, jasa pajak, tax consultant, konsultan pajak UMKM, restitusi PPN, audit pajak, konsultan pajak bersertifikat" />
    <meta property="og:title" content="Akurat Tax Consulting — Pajak Tepat, Bisnis Lancar." />
    <meta property="og:description" content="Konsultan pajak bersertifikat USKP A & B untuk UMKM, startup, dan perusahaan menengah." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1b3bd1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='%231b3bd1'/%3E%3Cpath d='M9 31 20 8l11 23M13 23h14' stroke='%23ffd93d' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Courier+Prime:wght@400;700&family=Public+Sans:wght@400..700&family=Reenie+Beanie&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#konten">Lewati ke konten</a>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="i-clip" viewBox="0 0 26 64"><path d="M9 46V12a7 7 0 0 1 14 0v38a10 10 0 0 1-20 0V16" /></symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M3 12h16M13 6l6 6-6 6" /></symbol>
    </svg>

    <!-- Navbar -->
    <header class="nav">
      <div class="nav__in">
        <a href="#" class="brand" aria-label="Akurat Tax Consulting, ke atas">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="#fff" stroke-width="3" /><circle cx="20" cy="20" r="13" fill="none" stroke="#fff" stroke-width="1.2" /><path d="M13 27 20 11l7 16M15.5 22.5h9" stroke="#ffd93d" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="brand__txt"><span class="brand__name">Akurat</span><span class="brand__sub">Tax Consulting</span></span>
        </a>
        <nav aria-label="Utama">
          <ul class="nav__links">
            <li><a href="#layanan">Layanan</a></li>
            <li><a href="#paket">Paket</a></li>
            <li><a href="#industri">Industri</a></li>
            <li><a href="#tim">Tim</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#blog">Blog</a></li>
          </ul>
        </nav>
        <div class="nav__cta">
          <a href="#konsultasi" class="btn">Konsultasi Gratis</a>
          <details class="menu">
            <summary aria-label="Buka menu">Menu</summary>
            <ul>
              <li><a href="#layanan">Layanan</a></li>
              <li><a href="#paket">Paket</a></li>
              <li><a href="#industri">Industri</a></li>
              <li><a href="#tim">Tim</a></li>
              <li><a href="#faq">FAQ</a></li>
              <li><a href="#blog">Blog</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main id="konten">
      <!-- Hero -->
      <section class="hero on-dark">
        <Stamp id="ring-bg" class="hero__ring" ring="PAJAK TEPAT • BISNIS LANCAR • PAJAK TEPAT • BISNIS LANCAR • " center="AKURAT" decor />
        <div class="hero__grid">
          <div class="hero__copy">
            <h1 class="display h1">Pajak Bukan Beban, Tapi <mark class="marker marker--full">Strategi.</mark></h1>
            <p class="lede">Konsultan pajak bersertifikat A & B yang membantu UMKM, startup, dan perusahaan menengah mengelola compliance, optimalisasi, dan pelaporan dengan presisi.</p>
            <div class="hero__cta">
              <a href="#konsultasi" class="btn">Konsultasi Gratis 30 Menit <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow" /></svg></a>
              <a href="#layanan" class="btn btn--line">Lihat Layanan</a>
            </div>
            <p class="hero__note">Tanpa biaya. Tanpa komitmen.</p>
          </div>

          <div class="collage">
            <figure class="print" style="margin:0">
              <span class="tape tape--a"></span><span class="tape tape--b"></span>
              <img src="/img/hero-tax-form.jpg" alt="Tangan mengisi formulir pajak 1040 di samping kalkulator" width="1400" height="933" fetchpriority="high" />
              <figcaption class="pen">pajak tepat.</figcaption>
            </figure>

            <article class="sheet fold spt" aria-label="Contoh ilustrasi formulir SPT Masa PPN">
              <svg class="clip" viewBox="0 0 26 64" aria-hidden="true"><use href="#i-clip" /></svg>
              <h3>SPT Masa PPN</h3>
              <div class="spt__meta"><span>NPWP 01.234.567.8-091.000</span><span>Masa: Okt 2026</span></div>
              <div class="spt__row"><span>Pajak Keluaran</span><b style="--d:0.7s">Rp 84.250.000</b></div>
              <div class="spt__row"><span>Pajak Masukan</span><b style="--d:1.1s">Rp 61.900.000</b></div>
              <div class="spt__row"><span>Kurang Bayar</span><b style="--d:1.5s">Rp 22.350.000</b></div>
              <div class="spt__row spt__row--due"><span>Batas lapor</span><b style="--d:1.9s">30 Nov 2026</b></div>
              <ul class="spt__checks">
                {["Dokumen lengkap", "Perhitungan diverifikasi", "Dijadwalkan lapor"].map((c, i) => (
                  <li><span class="spt__box"><svg viewBox="0 0 26 24" aria-hidden="true"><path class="draw" pathLength="1" d="M3 13l6 7L23 3" style={`--d:${2.5 + i * 0.3}s`} /></svg></span>{c}</li>
                ))}
              </ul>
              <p class="spt__foot">CONTOH ILUSTRASI · ANGKA FIKTIF</p>
            </article>

            <Stamp id="ring-hero" class="stamp" center="AKURAT" sub="DIPERIKSA" label="Stempel Akurat: diperiksa" />
            <div class="sticky"><p class="pen" style="margin:0">Lapor sebelum 30 Nov!</p></div>
          </div>
        </div>

        <div class="receipt">
          <div class="receipt__in">
            <ul>
              <li class="leader"><span>Klien aktif</span><i></i><b class="num"><span data-count="200">200</span>+</b></li>
              <li class="leader"><span>Pengalaman</span><i></i><b class="num">12+ tahun</b></li>
              <li class="leader"><span>Response time</span><i></i><b class="num">&lt; 4 jam</b></li>
            </ul>
            <ul>
              <li class="leader"><span>Bersertifikat</span><i></i><b>USKP-A &amp; B</b></li>
              <li class="leader"><span>Terdaftar</span><i></i><b>Kemenkeu</b></li>
              <li class="leader"><span>Kantor</span><i></i><b>JKT · SBY · BDG</b></li>
            </ul>
            <div class="barcode" aria-hidden="true"></div>
          </div>
        </div>
      </section>

      <!-- Pain points -->
      <section class="sec sec--graph" id="masalah">
        <div class="wrap">
          <div class="head">
            <h2 class="display h2">Kenali Tanda Bisnis Anda Butuh Konsultan Pajak</h2>
            <p class="lede" style="--d:100ms">Masalah pajak yang sering dihadapi bisnis, dan bagaimana kami membantu menyelesaikannya.</p>
          </div>
          <div class="pain">
            <div class="pain__print rv">
              <figure class="print" style="margin:0">
                <span class="tape"></span>
                <img src="/img/pain-need-help.jpg" alt="Formulir pajak dengan sticky note bertuliskan Need help?" width="1000" height="1500" loading="lazy" />
                <figcaption class="pen">familier? itu tandanya.</figcaption>
              </figure>
            </div>
            {pain.map((p, i) => (
              <article class={`slip rv rv--tilt ${p.carbon ? "slip--carbon" : ""} ${p.letter ? "slip--letter" : ""}`} style={`--r:${p.r};--d:${(i % 2) * 120}ms`}>
                <h3 class="display h3">{p.title}</h3>
                <p>{p.problem}</p>
                <span class="pen">{p.fix}</span>
                {p.letter && <span class="stamp-box" style="position:absolute;right:1rem;bottom:1rem;rotate:-9deg">SEGERA</span>}
              </article>
            ))}
            <div class="pain__close rv">
              <p class="pen">Salah satunya terasa akrab? Ceritakan ke kami.</p>
              <a href="#konsultasi" class="btn btn--ink">Jadwalkan Konsultasi <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow" /></svg></a>
            </div>
          </div>
        </div>
      </section>

      <!-- Services -->
      <section class="sec sec--sheet" id="layanan">
        <div class="wrap">
          <div class="head head--split">
            <h2 class="display h2">Layanan Konsultasi Pajak Lengkap</h2>
            <p class="lede" style="--d:100ms">Dari compliance harian hingga strategi pajak jangka panjang, semua dalam satu tim.</p>
          </div>
          <div class="svc">
            <ul class="svc__list">
              {services.map((s, i) => (
                <li class="svc__item">
                  <h3 style="margin:0">
                    <button class="svc__btn" type="button" aria-expanded="false" aria-controls={`svc-panel-${i}`} id={`svc-btn-${i}`}><span>{s.name}</span><i aria-hidden="true"></i></button>
                  </h3>
                  <div class="svc__panel" id={`svc-panel-${i}`} role="region" aria-labelledby={`svc-btn-${i}`}>
                    <div>
                      <img class="svc__inline" src={`/img/${s.img}.jpg`} alt={s.alt} width="1100" height="733" loading="lazy" />
                      <ul class="tick-list">{s.items.map((it) => <li>{it}</li>)}</ul>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <div class="svc__stage" aria-hidden="true">
              {services.map((s, i) => (
                <div class="svc__print" style={`--r:${s.r}`}>
                  <figure class="proof">
                    <span class="marks"></span>
                    <svg class="reg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" /><path d="M12 1v22M1 12h22" /></svg>
                    <img src={`/img/${s.img}.jpg`} alt="" width="1100" height="733" loading="lazy" />
                    <figcaption class="proof__cap pen">{s.name}</figcaption>
                  </figure>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Packages -->
      <section class="sec sec--graph" id="paket">
        <div class="wrap">
          <div class="head">
            <h2 class="display h2">Paket Layanan</h2>
            <p class="lede" style="--d:100ms">Pilih sesuai skala bisnis. Semua paket termasuk konsultasi WhatsApp &amp; monthly report.</p>
          </div>
          <div class="plans">
            {plans.map((p, i) => (
              <article class={`plan rv ${p.pop ? "plan--pop on-cobalt on-dark" : ""} ${p.carbon ? "plan--carbon" : ""}`} style={`--d:${i * 110}ms`}>
                {p.pop && <span class="plan__tab label">Most Popular</span>}
                <h3 class="display h3">{p.key}</h3>
                <p class="plan__for">{p.who}</p>
                <div class="plan__price num"><small>Rp</small>{p.price}<small>{p.unit}</small></div>
                <ul class="tick-list">{p.items.map((it) => <li>{it}</li>)}</ul>
                <a href="#konsultasi" class={`btn ${p.btn}`}>{p.cta} <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow" /></svg></a>
              </article>
            ))}
          </div>
          <div class="once-wrap rv rv--drop">
            <div class="once sheet">
              <h3 class="label">Butuh layanan sekali jalan?</h3>
              <ul>{once.map(([n, v]) => <li class="leader"><span>{n}</span><i></i><b class="num">{v}</b></li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Industries -->
      <section class="sec sec--sheet" id="industri">
        <div class="wrap">
          <div class="head head--split">
            <h2 class="display h2">Spesialis Industri</h2>
            <p class="lede" style="--d:100ms">Setiap industri punya kompleksitas pajak yang berbeda. Tim kami berpengalaman di:</p>
          </div>
          <div class="mosaic">
            {industries.map((x, i) => (
              <article class={`tile rv rv--pop ${x.t}`} style={`--d:${(i % 4) * 90}ms`}>
                <img src={`/img/${x.img}.jpg`} alt={x.alt} loading="lazy" />
                <div class="tag">
                  <h3 class="display h3">{x.name}</h3>
                  <p>{x.tax}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Why Akurat -->
      <section class="sec sec--cobalt on-dark" id="mengapa">
        <div class="wrap why">
          <div>
            <h2 class="display h2">Kenapa 200+ Bisnis <span class="marker marker--full">Percaya Kami</span></h2>
            <p class="lede" style="--d:100ms">Kami tidak hanya mengurus pajak. Kami membangun kepercayaan, satu checklist demi satu checklist.</p>
            <figure class="print why__print rv" style="margin-bottom:0">
              <span class="tape"></span>
              <img src="/img/why-dashboard.jpg" alt="Laptop menampilkan dashboard laporan di samping dokumen" width="900" height="1350" loading="lazy" />
              <figcaption class="pen">status real-time</figcaption>
            </figure>
          </div>
          <div class="sheet fold checks" data-inview>
            <div class="checks__title"><h3 class="display h3" style="margin:0">Checklist Kepatuhan</h3><span class="label">6 dari 6</span></div>
            {why.map(([t, d], i) => (
              <div class="chk rv" style={`--d:${i * 130}ms`}>
                <span class="chk__box"><svg viewBox="0 0 26 24" aria-hidden="true"><path class="draw" pathLength="1" d="M3 13l6 7L23 3" /></svg></span>
                <div><h3 class="display h3">{t}</h3><p>{d}</p></div>
              </div>
            ))}
            <Stamp id="ring-why" class="stamp" center="AKURAT" sub="DISETUJUI" ring="SEMUA TERPENUHI • KONSULTAN BERSERTIFIKAT • " decor />
          </div>
        </div>
      </section>

      <!-- Team -->
      <section class="sec sec--graph" id="tim">
        <div class="wrap">
          <div class="head">
            <h2 class="display h2">Tim Konsultan Bersertifikat</h2>
            <p class="lede" style="--d:100ms">Didukung 12 konsultan &amp; 8 support staff yang siap membantu Anda.</p>
          </div>
          <div class="team">
