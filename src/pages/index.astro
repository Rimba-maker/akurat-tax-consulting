---
import "../styles/global.css";
import Stamp from "../components/Stamp.astro";

const pain = [
  { title: "Bingung Lapor SPT Bulanan/Tahunan", problem: "Salah lapor = denda Rp100k - jutaan per bulan.", fix: "Kami handle semua filing tepat waktu.", r: "-1.2deg" },
  { title: "Pajak Selalu Lebih Besar Dari Kompetitor", problem: "Mungkin Anda belum optimalisasi.", fix: "Kami analisa struktur pajak Anda.", r: "1.6deg", carbon: true },
  { title: "Dapat Surat Tagihan / SP2DK dari KPP", problem: "Butuh response cepat & tepat.", fix: "Tim kami siap handle dispute resolution.", r: "1deg", letter: true },
  { title: "Mau Restitusi, Tapi Takut Diperiksa", problem: "Takut restitusi berujung pemeriksaan?", fix: "Kami bantu strategi restitusi yang aman dengan persiapan dokumen lengkap.", r: "-1.4deg" },
  { title: "Bisnis Multi-Channel, Reporting Kompleks", problem: "Online + offline = kompleksitas.", fix: "Kami bikin reporting jadi sederhana.", r: "1.2deg" },
  { title: "Setup PT Baru, Bingung Struktur Pajak", problem: "PPh Badan vs PPh Final?", fix: "Kami bantu pilih struktur yang tepat.", r: "-0.8deg", carbon: true },
];

const ld = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Akurat Tax Consulting",
  description: "Konsultan pajak bersertifikat USKP A & B: tax compliance, planning, audit, restitusi.",
  areaServed: ["Jakarta Selatan", "Surabaya", "Bandung"],
  slogan: "Pajak Tepat, Bisnis Lancar.",
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Akurat Tax Consulting — Konsultan Pajak Bersertifikat USKP Jakarta</title>
    <meta name="description" content="Konsultan pajak bersertifikat USKP A & B. Tax compliance, planning, audit, restitusi untuk UMKM, startup, & perusahaan menengah. 200+ klien aktif." />
    <meta name="keywords" content="konsultan pajak jakarta, jasa pajak, tax consultant, konsultan pajak UMKM, restitusi PPN, audit pajak, konsultan pajak bersertifikat" />
    <meta property="og:title" content="Akurat Tax Consulting — Pajak Tepat, Bisnis Lancar." />
    <meta property="og:description" content="Konsultan pajak bersertifikat USKP A & B untuk UMKM, startup, dan perusahaan menengah." />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1b3bd1" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='%231b3bd1'/%3E%3Cpath d='M9 31 20 8l11 23M13 23h14' stroke='%23ffd93d' stroke-width='4' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Courier+Prime:wght@400;700&family=Public+Sans:wght@400..700&family=Reenie+Beanie&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#konten">Lewati ke konten</a>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="i-clip" viewBox="0 0 26 64"><path d="M9 46V12a7 7 0 0 1 14 0v38a10 10 0 0 1-20 0V16" /></symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M3 12h16M13 6l6 6-6 6" /></symbol>
    </svg>

    <!-- Navbar -->
    <header class="nav">
      <div class="nav__in">
        <a href="#" class="brand" aria-label="Akurat Tax Consulting, ke atas">
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="#fff" stroke-width="3" /><circle cx="20" cy="20" r="13" fill="none" stroke="#fff" stroke-width="1.2" /><path d="M13 27 20 11l7 16M15.5 22.5h9" stroke="#ffd93d" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="brand__txt"><span class="brand__name">Akurat</span><span class="brand__sub">Tax Consulting</span></span>
        </a>
        <nav aria-label="Utama">
          <ul class="nav__links">
            <li><a href="#layanan">Layanan</a></li>
            <li><a href="#paket">Paket</a></li>
            <li><a href="#industri">Industri</a></li>
            <li><a href="#tim">Tim</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#blog">Blog</a></li>
          </ul>
        </nav>
        <div class="nav__cta">
          <a href="#konsultasi" class="btn">Konsultasi Gratis</a>
          <details class="menu">
            <summary aria-label="Buka menu">Menu</summary>
            <ul>
              <li><a href="#layanan">Layanan</a></li>
              <li><a href="#paket">Paket</a></li>
              <li><a href="#industri">Industri</a></li>
              <li><a href="#tim">Tim</a></li>
              <li><a href="#faq">FAQ</a></li>
              <li><a href="#blog">Blog</a></li>
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main id="konten">
      <!-- Hero -->
      <section class="hero on-dark">
        <Stamp id="ring-bg" class="hero__ring" ring="PAJAK TEPAT • BISNIS LANCAR • PAJAK TEPAT • BISNIS LANCAR • " center="AKURAT" decor />
        <div class="hero__grid">
          <div class="hero__copy">
            <h1 class="display h1">Pajak Bukan Beban, Tapi <mark class="marker marker--full">Strategi.</mark></h1>
            <p class="lede">Konsultan pajak bersertifikat A & B yang membantu UMKM, startup, dan perusahaan menengah mengelola compliance, optimalisasi, dan pelaporan dengan presisi.</p>
            <div class="hero__cta">
              <a href="#konsultasi" class="btn">Konsultasi Gratis 30 Menit <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow" /></svg></a>
              <a href="#layanan" class="btn btn--line">Lihat Layanan</a>
            </div>
            <p class="hero__note">Tanpa biaya. Tanpa komitmen.</p>
          </div>

          <div class="collage">
            <figure class="print" style="margin:0">
              <span class="tape tape--a"></span><span class="tape tape--b"></span>
              <img src="/img/hero-tax-form.jpg" alt="Tangan mengisi formulir pajak 1040 di samping kalkulator" width="1400" height="933" fetchpriority="high" />
              <figcaption class="pen">pajak tepat.</figcaption>
            </figure>

            <article class="sheet fold spt" aria-label="Contoh ilustrasi formulir SPT Masa PPN">
              <svg class="clip" viewBox="0 0 26 64" aria-hidden="true"><use href="#i-clip" /></svg>
              <h3>SPT Masa PPN</h3>
              <div class="spt__meta"><span>NPWP 01.234.567.8-091.000</span><span>Masa: Okt 2026</span></div>
              <div class="spt__row"><span>Pajak Keluaran</span><b style="--d:0.7s">Rp 84.250.000</b></div>
              <div class="spt__row"><span>Pajak Masukan</span><b style="--d:1.1s">Rp 61.900.000</b></div>
              <div class="spt__row"><span>Kurang Bayar</span><b style="--d:1.5s">Rp 22.350.000</b></div>
              <div class="spt__row spt__row--due"><span>Batas lapor</span><b style="--d:1.9s">30 Nov 2026</b></div>
              <ul class="spt__checks">
                {["Dokumen lengkap", "Perhitungan diverifikasi", "Dijadwalkan lapor"].map((c, i) => (
                  <li><span class="spt__box"><svg viewBox="0 0 26 24" aria-hidden="true"><path class="draw" pathLength="1" d="M3 13l6 7L23 3" style={`--d:${2.5 + i * 0.3}s`} /></svg></span>{c}</li>
                ))}
              </ul>
              <p class="spt__foot">CONTOH ILUSTRASI · ANGKA FIKTIF</p>
            </article>

            <Stamp id="ring-hero" class="stamp" center="AKURAT" sub="DIPERIKSA" label="Stempel Akurat: diperiksa" />
            <div class="sticky"><p class="pen" style="margin:0">Lapor sebelum 30 Nov!</p></div>
          </div>
        </div>

        <div class="receipt">
          <div class="receipt__in">
            <ul>
              <li class="leader"><span>Klien aktif</span><i></i><b class="num"><span data-count="200">200</span>+</b></li>
              <li class="leader"><span>Pengalaman</span><i></i><b class="num">12+ tahun</b></li>
              <li class="leader"><span>Response time</span><i></i><b class="num">&lt; 4 jam</b></li>
            </ul>
            <ul>
              <li class="leader"><span>Bersertifikat</span><i></i><b>USKP-A &amp; B</b></li>
              <li class="leader"><span>Terdaftar</span><i></i><b>Kemenkeu</b></li>
              <li class="leader"><span>Kantor</span><i></i><b>JKT · SBY · BDG</b></li>
            </ul>
            <div class="barcode" aria-hidden="true"></div>
          </div>
        </div>
      </section>

      <!-- Pain points -->
      <section class="sec sec--graph" id="masalah">
        <div class="wrap">
          <div class="head">
            <h2 class="display h2">Kenali Tanda Bisnis Anda Butuh Konsultan Pajak</h2>
            <p class="lede" style="--d:100ms">Masalah pajak yang sering dihadapi bisnis, dan bagaimana kami membantu menyelesaikannya.</p>
          </div>
          <div class="pain">
            <div class="pain__print rv">
              <figure class="print" style="margin:0">
                <span class="tape"></span>
                <img src="/img/pain-need-help.jpg" alt="Formulir pajak dengan sticky note bertuliskan Need help?" width="1000" height="1500" loading="lazy" />
                <figcaption class="pen">familier? itu tandanya.</figcaption>
              </figure>
            </div>
            {pain.map((p, i) => (
              <article class={`slip rv rv--tilt ${p.carbon ? "slip--carbon" : ""} ${p.letter ? "slip--letter" : ""}`} style={`--r:${p.r};--d:${(i % 2) * 120}ms`}>
                <h3 class="display h3">{p.title}</h3>
                <p>{p.problem}</p>
                <span class="pen">{p.fix}</span>
                {p.letter && <span class="stamp-box" style="position:absolute;right:1rem;bottom:1rem;rotate:-9deg">SEGERA</span>}
              </article>
            ))}
            <div class="pain__close rv">
              <p class="pen">Salah satunya terasa akrab? Ceritakan ke kami.</p>
              <a href="#konsultasi" class="btn btn--ink">Jadwalkan Konsultasi <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#i-arrow" /></svg></a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot on-dark">
      <div class="foot__grid">
        <div class="foot__brand">
          <a href="#" class="brand" aria-label="Akurat Tax Consulting">
            <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="none" stroke="#fff" stroke-width="3" /><circle cx="20" cy="20" r="13" fill="none" stroke="#fff" stroke-width="1.2" /><path d="M13 27 20 11l7 16M15.5 22.5h9" stroke="#ffd93d" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="brand__txt"><span class="brand__name">Akurat</span><span class="brand__sub">Tax Consulting</span></span>
          </a>
          <p class="foot__tag">Akurat, dipercaya, berkelanjutan.</p>
        </div>
        <div>
          <h3 class="label">Layanan</h3>
          <ul><li><a href="#layanan">Tax Compliance</a></li><li><a href="#layanan">Tax Planning</a></li><li><a href="#layanan">Audit Assistance</a></li><li><a href="#layanan">Restitusi Pajak</a></li></ul>
        </div>
        <div>
          <h3 class="label">Perusahaan</h3>
          <ul><li><a href="#mengapa">Tentang Kami</a></li><li><a href="#tim">Tim</a></li><li><a href="#proses">Proses</a></li><li><a href="#blog">Blog</a></li></ul>
        </div>
        <div>
          <h3 class="label">Kantor</h3>
          <ul><li>Jakarta Selatan</li><li>Surabaya</li><li>Bandung</li></ul>
        </div>
        <div>
          <h3 class="label">Sertifikasi</h3>
          <ul><li>USKP-A &amp; B</li><li>Terdaftar IKPI</li><li>ISO 27001</li><li>Indonesia Tax Consultant Association</li></ul>
        </div>
      </div>
      <div class="foot__base">
        <span>&copy; 2026 Akurat Tax Consulting. All rights reserved.</span>
        <!-- TODO: add the LinkedIn URL when the client supplies it -->
        <span>LinkedIn · <a href="https://instagram.com/akurat.tax" rel="noopener">Instagram @akurat.tax</a></span>
      </div>
      <svg class="foot__word" viewBox="0 0 1000 200" aria-hidden="true"><text x="0" y="214" font-size="300" textLength="1000" lengthAdjust="spacingAndGlyphs">AKURAT</text></svg>
    </footer>

    <script>
      // reveal on scroll
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }),
        { threshold: 0.15, rootMargin: "0px 0px -6% 0px" },
      );
      document.querySelectorAll(".rv, .marker, [data-inview]").forEach((el) => io.observe(el));

      // count-up
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
        const n = Number(el.dataset.count);
        const co = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          co.disconnect();
          if (reduce) return;
          const t0 = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / 1400);
            el.textContent = String(Math.round(n * (1 - (1 - p) ** 3)));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
        co.observe(el);
      });

      // mobile menu closes after picking a link
      document.querySelectorAll(".menu a").forEach((a) => a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")));
    </script>
  </body>
</html>
