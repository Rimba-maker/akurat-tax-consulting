    <script>
      // reveal on scroll
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }),
        { threshold: 0.15, rootMargin: "0px 0px -6% 0px" },
      );
      document.querySelectorAll(".rv, .marker, [data-inview]").forEach((el) => io.observe(el));

      // count-up
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.querySelectorAll<HTMLElement>("[data-count]").forEach((el) => {
        const n = Number(el.dataset.count);
        const co = new IntersectionObserver(([e]) => {
          if (!e.isIntersecting) return;
          co.disconnect();
          if (reduce) return;
          const t0 = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / 1400);
            el.textContent = String(Math.round(n * (1 - (1 - p) ** 3)));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
        co.observe(el);
      });

      // services: one open at a time, photo print follows
      const btns = [...document.querySelectorAll<HTMLButtonElement>(".svc__btn")];
      const prints = [...document.querySelectorAll<HTMLElement>(".svc__print")];
      const open = (i: number) =>
        btns.forEach((b, j) => {
          const on = i === j;
          b.setAttribute("aria-expanded", String(on));
          document.getElementById(b.getAttribute("aria-controls")!)?.toggleAttribute("data-open", on);
          prints[j]?.classList.toggle("is-on", on);
        });
      btns.forEach((b, i) => b.addEventListener("click", () => open(i)));
      open(0);

      // mobile menu closes after picking a link
      document.querySelectorAll(".menu a").forEach((a) => a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")));
    </script>
